{
  "_meta": {
    "purpose": "stage-1 oracle falsification for M2 typed-record design (TYPED_RECORD_DESIGN_V2.md): hand-annotated ideal typed fields on real snapshot records (results/lme150_rlx1/models/, selfc-era ingest stack). If deterministic aggregation over perfect fields cannot rescue the residual enum questions, this schema+chain implementation is falsified.",
    "record_schema": {
      "rid": "source record id",
      "event_id": "independent id per record (never merged)",
      "kind": "asserted|negated|planned|cancelled",
      "verb": "normalized predicate",
      "object": "what the predicate acts on",
      "quantity": "number|null",
      "quantifier": "explicit|unspecified|null",
      "when_abs": "ISO date or null",
      "granularity": "day|week|month|year|null",
      "dup_links": "suspected-duplicate rids (edge, not merge)",
      "counts_toward": "the question's predicate universe: in|out|boundary"
    }
  },
